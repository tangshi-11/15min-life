# ============================================================
# 15分钟生活圈 · 智能体检与规划助手 — 环境变量样例
# 复制为 .env 后填写（.env 已在 .gitignore 中忽略，不会泄露密钥）
# ============================================================

# 百度地图开放平台密钥（https://lbsyun.baidu.com 控制台 → 应用管理 → 我的应用 → 创建应用）
# 服务端 AK：地理编码 / POI 检索 / 路线规划 / 批量算路使用（应用类型选「服务端」）
BAIDU_AK_SERVER=
# 浏览器端 AK（可选）：前端如需接入百度地图 JS 渲染时填写（应用类型选「浏览器端」）
BAIDU_AK_BROWSER=
# 是否强制使用演示数据（1/true/on 为强制；留空时：有 AK 走实时，无 AK 走演示）
FORCE_MOCK=
# 百度地图接口 QPS 限制（个人认证默认较低，可按需调整；程序内置令牌桶限流）
BAIDU_QPS=10

# 步行体检时间（分钟）
WALK_MINUTES=15

# 等时圈采样参数：扇区数 / 采样步长(米) / 最大采样半径(米) / IDW 网格分辨率 / 批量算路分块
SAMPLE_DIRECTIONS=24
SAMPLE_STEP_M=100
MAX_RADIUS_M=2000
GRID_N=60
MATRIX_CHUNK=90

# POI 检索半径 / 盲区识别参数（米）
POI_RADIUS_M=2500
BLIND_RADIUS_M=1000
BLIND_CELL_M=200

# 演示数据随机种子
MOCK_SEED=42
